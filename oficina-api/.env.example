# Valores fictícios. Os reais ficam no painel da Vercel ou no .env local, nunca no Git.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://oficina:oficina-local@localhost:5432/oficina
DATABASE_POOL_MAX=5
# na Vercel: pooler do Supabase em modo transação (porta 6543), DATABASE_POOL_MAX=3 e a CA abaixo
# DATABASE_SSL_CA=<certificado PEM da CA do provedor do banco>. Com ela, não usar sslmode na URL
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais
JWT_EXPIRES_IN=1h
JWT_ISSUER=oficina-api
JWT_AUDIENCE=oficina-clientes
LOG_LEVEL=info
# cria admin, atendente e técnico de demonstração ao subir o container
SEED_DEMO=true
# testes: usa este servidor PostgreSQL em vez de Testcontainers
# TEST_DATABASE_URL=postgres://postgres:teste@localhost:5432/postgres
