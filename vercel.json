{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "portal": {
      "root": "portal/"
    },
    "api": {
      "root": "oficina-api/",
      "framework": "fastify",
      "entrypoint": "src/main/server.ts"
    }
  },
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "portal" } }
  ]
}
